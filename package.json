{
    "name": "@thewaver/ss-utils",
    "type": "module",
    "version": "0.0.22",
    "description": "Geometry, CSS, SVG and DOM helpers for building shaped UI.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "license": "MIT",
    "author": "Luís Santos",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thewaver/ss-utils.git"
    },
    "bugs": {
        "url": "https://github.com/thewaver/ss-utils/issues"
    },
    "homepage": "https://github.com/thewaver/ss-utils#readme",
    "keywords": [
        "geometry",
        "polygon",
        "svg",
        "css",
        "shape",
        "superellipse",
        "squircle",
        "text-measurement"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "csstype": "^3.2.3",
        "fast-equals": "^6.0.2"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 120,
        "quoteProps": "consistent",
        "plugins": [
            "@trivago/prettier-plugin-sort-imports"
        ],
        "importOrder": [
            "^[a-z]",
            "^@",
            "^[./](?!.*\\.css$)",
            ".*\\.css$"
        ],
        "importOrderSeparation": true,
        "importOrderSortSpecifiers": true
    },
    "allowScripts": {
        "esbuild@0.27.2": true
    }
}
